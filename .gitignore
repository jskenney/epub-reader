# Self-hosted natural-voice files, fetched by fetch-kokoro.sh, fetch-pocket.sh, fetch-zonos.sh and fetch-reverb.sh (hundreds of MB;
# too big for git). ZONOS3's engine (zonos/engine/) is part of the reader and committed.
/kokoro/
/pocket/
/zonos/models/
/reverb/models/

# Self-hosted libraries and fonts, fetched by fetch-libs.sh and fetch-fonts.sh
/libs/
/fonts/

# Server voice clips from older setups (they now live on the TTS server; see epub-reader-tts-server)
/tts-voices/

# The book a site opens by default (see DEFAULT_BOOK), and a site's own per-folder settings
default.epub
default.md
default.html
reader-config.json

# Interrupted or in-progress downloads
*.part

# Test site built by tests/build_fixtures.py, and test dependencies
/tests/site/
/tests/node_modules/
__pycache__/
