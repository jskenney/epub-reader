# Self-hosted natural-voice files, fetched by fetch-kokoro.sh and fetch-pocket.sh (hundreds of MB; too big for git)
/kokoro/
/pocket/

# Self-hosted libraries and fonts, fetched by fetch-libs.sh and fetch-fonts.sh
/libs/
/fonts/

# Server voice clips from older setups (they now live on the TTS server; see epub-reader-tts-server)
/tts-voices/

# The book a site opens by default (see DEFAULT_BOOK)
default.epub

# Interrupted or in-progress downloads
*.part

# Test site built by tests/build_fixtures.py, and test dependencies
/tests/site/
/tests/node_modules/
